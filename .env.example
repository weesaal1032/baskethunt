APP_NAME=CallHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=callhub
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="callhub@example.com"
MAIL_FROM_NAME="${APP_NAME}"

CALLHUB_STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
CALLHUB_TELEPHONY_BASE_URL=
CALLHUB_TELEPHONY_AUTH=header
CALLHUB_TELEPHONY_API_KEY=
CALLHUB_TELEPHONY_PAGINATION=100
CALLHUB_TELEPHONY_RATE_LIMIT=
CALLHUB_TELEPHONY_POLL_WINDOW=7
CALLHUB_TRANSCRIPTION_DRIVER=whisper_api
WHISPER_API_ENDPOINT=https://api.openai.com/v1/audio/transcriptions
WHISPER_API_KEY=
WHISPER_API_TIMEOUT=30
WHISPER_CLI_BINARY=/usr/local/bin/whisper
WHISPER_CLI_MODEL=base.en
WHISPER_CLI_THREADS=4
WHISPER_CLI_TIMEOUT=600
CALLHUB_TRANSCRIPTION_DAILY_LIMIT=0
FFMPEG_BINARY=ffmpeg
CALLHUB_ADMIN_EMAIL=admin@example.com
CALLHUB_ADMIN_PASSWORD=ChangeMe123!
CALLHUB_EMAIL_OTP=false
CALLHUB_EMAIL_OTP_EXPIRY=10
CALLHUB_LOGIN_ATTEMPTS=5
CALLHUB_LOGIN_DECAY=60
CALLHUB_PRIVACY_PII_MASKING=true
CALLHUB_RETENTION_MONTHS=12
CALLHUB_DELETION_GRACE_DAYS=14
CALLHUB_STORAGE_ALERT_PERCENT=80
CALLHUB_STORAGE_ALERT_S3_GB=0
CALLHUB_ALERT_RECIPIENTS="ops@example.com,security@example.com"
CALLHUB_TRANSCRIPTION_BACKLOG_THRESHOLD=20
